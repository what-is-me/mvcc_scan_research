{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "mingw",
      "inherits": "base",
      "displayName": "MinGW GCC 16 (Ninja)",
      "description": "普通终端即可使用；默认工具链",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static"
      }
    },
    {
      "name": "mingw-debug",
      "inherits": "mingw",
      "displayName": "MinGW GCC 16 Debug (Ninja)",
      "description": "断言开启；目录固定为 build/_dbg，反复增量复用，不必每次重建",
      "binaryDir": "${sourceDir}/build/_dbg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc",
      "inherits": "base",
      "displayName": "MSVC 19.5x (Ninja)",
      "description": "需在 Developer PowerShell 或 CLion 中运行",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "clang",
      "inherits": "base",
      "displayName": "Clang 22 (Ninja, MSVC ABI)",
      "description": "需在 Developer PowerShell 中运行",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "Linux ThreadSanitizer",
      "description": "仅在 Linux / WSL 下可用；Windows 没有 TSan 运行时",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "MVCC_SANITIZER": "thread",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    }
  ],
  "buildPresets": [
    { "name": "mingw", "configurePreset": "mingw" },
    { "name": "mingw-debug", "configurePreset": "mingw-debug" },
    { "name": "msvc", "configurePreset": "msvc" },
    { "name": "clang", "configurePreset": "clang" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    { "name": "mingw", "configurePreset": "mingw", "output": { "outputOnFailure": true } },
    { "name": "mingw-debug", "configurePreset": "mingw-debug", "output": { "outputOnFailure": true } },
    { "name": "msvc", "configurePreset": "msvc", "output": { "outputOnFailure": true } },
    { "name": "clang", "configurePreset": "clang", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } }
  ]
}
